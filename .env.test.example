# ──────────────────────────────────────────────────────────────
# .env.test.example
# Copy this file to .env.test and fill in the values.
# NEVER commit .env.test to version control.
# ──────────────────────────────────────────────────────────────

NODE_ENV=test
PORT=3000

# ── Database ──────────────────────────────────────────────────
# Local Docker (test:local):
DATABASE_URL="postgresql://test_user:test_password@localhost:55432/elevo_test_db?schema=auth"

# ── JWT (RS256) ───────────────────────────────────────────────
# Generate a test keypair:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
#
# Then paste the contents here (keep the newlines with \n):
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── Security ──────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000"

# ── Rate Limits (high values for testing) ─────────────────────
RATE_LIMIT_LOGIN=1000
RATE_LIMIT_REGISTER=1000
RATE_LIMIT_REFRESH=1000
RATE_LIMIT_LOGOUT=1000
RATE_LIMIT_FORGOT_PASSWORD=1000
RATE_LIMIT_RESET_PASSWORD=1000
RATE_LIMIT_VERIFY_EMAIL=1000
RATE_LIMIT_RESEND_VERIFICATION=1000
