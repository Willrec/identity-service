# Application Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (Neon or any PostgreSQL instance)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# CORS Configuration (Comma-separated list of allowed client origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cryptographic & Security Constants
BCRYPT_SALT_ROUNDS=12

# JWT Configuration (RS256 Private and Public Key Pair in PEM format with literal \n escapes)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_2048_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_RSA_2048_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# Optional Secrets (if using legacy HS256 fallbacks, min 32 characters)
# JWT_ACCESS_SECRET=your_legacy_hs256_access_secret_here_at_least_32_chars
# JWT_REFRESH_SECRET=your_legacy_hs256_refresh_secret_here_at_least_32_chars

# Granular Rate Limiting (Default settings)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REFRESH=60
RATE_LIMIT_LOGOUT=60
RATE_LIMIT_FORGOT_PASSWORD=3
RATE_LIMIT_RESET_PASSWORD=5
RATE_LIMIT_VERIFY_EMAIL=10
RATE_LIMIT_RESEND_VERIFICATION=3
