# Application Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (Neon or any PostgreSQL instance)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# CORS Configuration (Comma-separated list of allowed client origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cryptographic & Security Constants
BCRYPT_SALT_ROUNDS=12

# JWT Configuration (RS256 Private and Public Key Pair in PEM format with literal \n escapes)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_2048_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_RSA_2048_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# Granular Rate Limiting (Default settings)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REFRESH=60
RATE_LIMIT_LOGOUT=60
RATE_LIMIT_FORGOT_PASSWORD=3
RATE_LIMIT_RESET_PASSWORD=5
RATE_LIMIT_VERIFY_EMAIL=10
RATE_LIMIT_RESEND_VERIFICATION=3

# Database Seeding Configuration
SEED_DEFAULT_ADMIN=false
DEFAULT_ADMIN_EMAIL=admin@identity-service.local
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_FIRST_NAME=Default
DEFAULT_ADMIN_LAST_NAME=Admin

# Amazon SES Configuration (For transactional emails)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=no-reply@elevo.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback

