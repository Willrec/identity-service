NODE_ENV=test
PORT=3000

# Testing Database
# Replace this with your actual Neon or Docker PostgreSQL test database connection string.
# WARNING: NEVER USE A PRODUCTION DATABASE HERE.
DATABASE_URL="postgresql://test_user:test_password@localhost:55432/elevo_test_db?schema=auth"

# Security
JWT_ACCESS_SECRET="test-access-secret-do-not-use-in-production-12345"

# CORS
CORS_ORIGINS="http://localhost:3000"

# Rate Limits (Disabled effectively by setting high values for testing)
RATE_LIMIT_LOGIN=1000
RATE_LIMIT_REGISTER=1000
RATE_LIMIT_REFRESH=1000
RATE_LIMIT_LOGOUT=1000
RATE_LIMIT_FORGOT_PASSWORD=1000
RATE_LIMIT_RESET_PASSWORD=1000
RATE_LIMIT_VERIFY_EMAIL=1000
RATE_LIMIT_RESEND_VERIFICATION=1000
