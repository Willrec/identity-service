{
  "name": "identity-service",
  "version": "0.1.0",
  "description": "Reusable generic Identity Service providing authentication, authorization, JWT tokens, sessions, RBAC, email verification, and password reset.",
  "keywords": [
    "identity-service",
    "authentication",
    "authorization",
    "jwt",
    "sessions",
    "rbac",
    "email-verification",
    "password-reset",
    "openapi",
    "docker",
    "ci"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env --import tsx/esm src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "openapi:validate": "redocly lint docs/openapi/openapi.json",
    "openapi:lint": "redocly lint docs/openapi/openapi.json",
    "openapi:bundle": "tsx scripts/generate-openapi.ts",
    "openapi:types": "orval",
    "openapi": "pnpm openapi:validate && pnpm openapi:lint && pnpm openapi:bundle && pnpm openapi:types",
    "test": "vitest run --coverage",
    "test:integration": "prisma generate && prisma validate && prisma migrate deploy && pnpm test",
    "test:local": "node scripts/test.js",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:db:reset": "npm run test:db:down && npm run test:db:up",
    "env:init": "node scripts/init-env.js",
    "keys:generate": "node scripts/generate-keys.js",
    "setup": "node scripts/setup.js",
    "seed": "node scripts/seed.js",
    "doctor": "node scripts/doctor.js"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@redocly/cli": "^2.34.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.17.0",
    "openapi-types": "^12.1.3",
    "orval": "^8.19.0",
    "prettier": "^3.4.2",
    "prisma": "^6.13.0",
    "prisma-erd-generator": "^2.4.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.9"
  }
}
